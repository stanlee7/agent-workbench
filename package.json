{
  "name": "agent-workbench",
  "version": "0.2.0",
  "description": "One desktop app, any CLI agents (Claude Code, Codex, Antigravity, more), each driving its own browser pane over MCP. Ask all at once, compare the answers, approve the risky clicks.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": [
    "electron",
    "mcp",
    "claude-code",
    "codex",
    "antigravity",
    "browser-agent",
    "ai-agents"
  ],
  "author": "stanlee7",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stanlee7/agent-workbench.git"
  },
  "homepage": "https://github.com/stanlee7/agent-workbench#readme",
  "devDependencies": {
    "electron-builder": "^26.18.0",
    "electron": "^38.8.6"
  },
  "build": {
    "appId": "dev.stanlee7.agent-workbench",
    "productName": "Agent Workbench",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Agent Workbench"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "publish": null
  }
}
